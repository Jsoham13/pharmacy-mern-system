PORT=5000
NODE_ENV=production

# MongoDB Connection: Use local or MongoDB Atlas Cloud URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pharmacy_store?retryWrites=true&w=majority

# Security: Provide a strong random secret in production
JWT_SECRET=super_secret_jwt_key_medical_store_v2_2026
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (comma-separated for CORS)
CLIENT_ORIGIN=https://your-frontend-app.vercel.app,http://localhost:5173

# Optional: Razorpay Payment Gateway (Live or Test keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Optional: Nodemailer SMTP Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Shree Ganesh Medical" <invoices@shreeganeshmedical.com>
